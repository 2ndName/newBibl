@model newBibl.ViewModels.EditionCreateViewModel

<h2>Создать издание</h2>

<form asp-action="Create">
    <div class="form-group mb-3">
        <label>Название</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label>Описание</label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="fw-bold">Авторы</label>

        @for (int i = 0; i < Model.Authors.Count; i++)
        {
            <div class="form-check">
                <input type="checkbox"
                       asp-for="Authors[i].IsSelected"
                       class="form-check-input" />

                <input type="hidden" asp-for="Authors[i].Id" />
                <input type="hidden" asp-for="Authors[i].Name" />

                <label class="form-check-label">
                    @Model.Authors[i].Name
                </label>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-success">Создать</button>
</form>
