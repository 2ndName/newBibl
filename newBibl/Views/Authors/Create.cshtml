@model newBibl.ViewModels.AuthorCreateViewModel

<h2>Создать автора</h2>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Biography"></label>
        <textarea asp-for="Biography" class="form-control"></textarea>
        <span asp-validation-for="Biography" class="text-danger"></span>
    </div>

    <hr />

    <h5>Издания (обязательно)</h5>

    @for (int i = 0; i < Model.Editions.Count; i++)
    {
        <div class="form-check">
            <input type="checkbox"
                   asp-for="Editions[i].IsSelected"
                   class="form-check-input" />
            <input type="hidden" asp-for="Editions[i].Id" />
            <label class="form-check-label">
                @Model.Editions[i].Name
            </label>
        </div>
    }

    <div class="mt-2 mb-3">
        <a asp-controller="Editions"
           asp-action="Create"
           class="btn btn-sm btn-outline-primary">
            + Добавить издание
        </a>
    </div>

    <hr />

    <h5>Книги (необязательно)</h5>

    @for (int i = 0; i < Model.Books.Count; i++)
    {
        <div class="form-check">
            <input type="checkbox"
                   asp-for="Books[i].IsSelected"
                   class="form-check-input" />
            <input type="hidden" asp-for="Books[i].Id" />
            <label class="form-check-label">
                @Model.Books[i].Name
            </label>
        </div>
    }

    <br />

    <button type="submit" class="btn btn-success">
        Создать
    </button>

</form>