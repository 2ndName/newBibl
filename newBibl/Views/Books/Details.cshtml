@model newBibl.Models.Book

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Book</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Название</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Страницы</dt>
        <dd class="col-sm-9">@Model.PageCount</dd>

        <dt class="col-sm-3">Автор</dt>
        <dd class="col-sm-9">@Model.Author?.Name</dd>

        <dt class="col-sm-3">Издания автора</dt>
        <dd class="col-sm-9">
            @(Model.Author?.Editions != null
                ? string.Join(", ", Model.Author.Editions.Select(e => e.Name))
                : "")
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
