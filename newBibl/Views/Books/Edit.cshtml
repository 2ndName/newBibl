@model newBibl.Models.Book

<h2>Редактировать книгу</h2>

<form asp-action="Edit">

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PageCount"></label>
        <input asp-for="PageCount" type="number" class="form-control" />
        <span asp-validation-for="PageCount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Автор</label>
        <select asp-for="AuthorId"
                class="form-select"
                asp-items="ViewBag.Authors">
        </select>
        <span asp-validation-for="AuthorId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Сохранить
    </button>
</form>